{
  "redirects": [
    { "source": "/OJA", "destination": "/oja", "permanent": true },
    { "source": "/OJP", "destination": "/ojp", "permanent": true },
    { "source": "/OJCS", "destination": "/ojcs", "permanent": true },
    { "source": "/OJW", "destination": "/ojw", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/oja", "destination": "/index.html" },
    { "source": "/ojp", "destination": "/index.html" },
    { "source": "/ojcs", "destination": "/index.html" },
    { "source": "/ojw", "destination": "/index.html" }
  ]
}
